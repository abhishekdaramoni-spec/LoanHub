# Flask Settings
FLASK_APP=run.py
FLASK_DEBUG=True
SECRET_KEY=loansphere-super-secure-secret-key-123456

# Database Settings
# Default connects to local MySQL. If connection fails, falls back to SQLite.
DB_USER=root
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_NAME=loansphere_db

# Mail configuration (optional sandbox)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=no-reply@loansphere.bank
